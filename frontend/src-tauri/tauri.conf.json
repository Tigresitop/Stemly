{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stemly",
  "mainBinaryName": "Stemly",
  "version": "0.1.1",
  "identifier": "com.tigresitop.stemly",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stemly",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "John Tigre",
    "copyright": "© 2026 John Ismael Tigre Cuji · Licencia MIT",
    "category": "Music",
    "shortDescription": "Separa voz, batería, bajo y más de cualquier canción",
    "longDescription": "Stemly separa una canción en sus pistas (voz, batería, bajo, guitarra, piano) con inteligencia artificial, 100% en tu computadora.",
    "homepage": "https://github.com/Tigresitop/Stemly",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}